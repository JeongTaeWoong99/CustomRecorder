<Window x:Class="CustomRecorder.App.Windows.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="녹화할 창 고르기" Width="1000" Height="680" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}" WindowStyle="SingleBorderWindow" ResizeMode="NoResize" Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header (drag area) -->
        <Grid Height="76" Margin="24,0,10,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="녹화할 창 고르기" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="고른 창만 녹화합니다. 다른 창에 가려져도 그대로 찍히고, 창을 옮기거나 크기를 바꿔도 따라갑니다."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid Width="240">
                    <TextBox x:Name="SearchBox" Padding="26,0,0,0" TextChanged="Search_TextChanged" ToolTip="창 제목이나 프로그램 이름으로 찾기"/>
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Foreground="{StaticResource TextDim}"
                               HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="창 이름으로 찾기" Foreground="{StaticResource TextFaint}" Margin="34,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Button Style="{StaticResource IconButton}" Width="34" Height="32" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="창 목록 새로 고침">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="13"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Width="34" Height="32" Margin="4,0,0,0" Click="Cancel_Click" ToolTip="닫기">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Thumbnails -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,10,0" ScrollChanged="Scroller_ScrollChanged">
            <WrapPanel x:Name="Cards" Margin="0,4,0,12"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="녹화할 수 있는 창이 없습니다." Foreground="{StaticResource TextDim}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <!-- Footer -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,12,22,14">
            <Grid>
                <TextBlock x:Name="SelectionText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,220,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DialogButton}" Content="취소" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="이 창 녹화하기" IsDefault="True" Click="Ok_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
