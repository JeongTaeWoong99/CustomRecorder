<Window x:Class="CustomRecorder.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CustomRecorder"
        Icon="/Assets/app.ico"
        Style="{StaticResource AppWindow}"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbRecord" Description="녹화 시작" Click="ThumbRecord_Click"/>
                <ThumbButtonInfo x:Name="ThumbCapture" Description="화면 캡처" Click="ThumbCapture_Click"/>
                <ThumbButtonInfo x:Name="ThumbReplay" Description="리플레이 켜기" Click="ThumbReplay_Click"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <!-- Big round record button -->
        <Style x:Key="RecordButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="8,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolCaption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Margin" Value="3,4,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="1.5" Background="{StaticResource Surface}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="1.5" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="RecRing" Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="{StaticResource Bg}">
        <StackPanel MinWidth="600">
            <!-- ===== Title bar (drag area) ===== -->
            <Grid Height="40" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="/Assets/app.ico" Width="16" Height="16" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="CustomRecorder" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                    <!-- Recording pill -->
                    <Border x:Name="RecPill" Background="{StaticResource RecSoft}" CornerRadius="10" Padding="9,2,10,2" Margin="12,0,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="TitleDot" Width="7" Height="7" Fill="{StaticResource Rec}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Rec}"
                                       FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="UpdatePill" Visibility="Collapsed" Click="UpdatePill_Click" Cursor="Hand" Margin="0,0,6,0"
                            ToolTip="새 버전이 있습니다. 눌러서 변경 내역을 보고 업데이트하세요.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="10,3,11,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" FontSize="11" Foreground="{StaticResource Accent}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="UpdatePillText" Text="업데이트" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Click="More_Click" ToolTip="예약 녹화 · 최근 녹화">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE712;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="작업 표시줄로 내리기">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE921;" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="닫기 (설정에 따라 알림 영역으로 숨김)">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== What to record ===== -->
            <Grid Margin="14,2,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeScreen" Style="{StaticResource ModeToggle}" GroupName="mode" IsChecked="True" Checked="Mode_Checked"
                                     ToolTip="모니터 한 대 전체를 녹화합니다">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7F4;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="전체 화면"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeRegion" Style="{StaticResource ModeToggle}" GroupName="mode" Checked="Mode_Checked"
                                     ToolTip="마우스로 드래그한 사각형 부분만 녹화합니다">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xF407;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="영역"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeWindow" Style="{StaticResource ModeToggle}" GroupName="mode" Checked="Mode_Checked"
                                     ToolTip="고른 창 하나만 녹화합니다. 다른 창에 가려져도 그대로 찍힙니다">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE737;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="창"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeAudio" Style="{StaticResource ModeToggle}" GroupName="mode" Checked="Mode_Checked"
                                     ToolTip="화면 없이 시스템 소리와 마이크만 녹음합니다">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8D6;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="소리만"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <ComboBox x:Name="MonitorCombo" MinWidth="250" SelectionChanged="MonitorCombo_SelectionChanged" ToolTip="녹화할 모니터"/>
                    <Button x:Name="PickButton" Style="{StaticResource DialogButton}" Padding="12,6" Click="Pick_Click" Visibility="Collapsed"/>
                    <TextBlock x:Name="TargetText" Foreground="{StaticResource TextDim}" Margin="10,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                </StackPanel>
            </Grid>

            <!-- ===== Actions ===== -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Record -->
                    <Button x:Name="RecordButton" Style="{StaticResource RecordButtonStyle}" Click="Record_Click">
                        <StackPanel>
                            <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                <Ellipse x:Name="RecRing" Stroke="{StaticResource Rec}" StrokeThickness="2"/>
                                <Ellipse x:Name="RecordIcon" Width="26" Height="26" Fill="{StaticResource Rec}"/>
                                <Rectangle x:Name="StopIcon" Width="15" Height="15" RadiusX="3" RadiusY="3" Fill="{StaticResource Rec}" Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock x:Name="RecordLabel" Text="녹화" Style="{StaticResource ToolCaption}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="PauseButton" Style="{StaticResource ToolButton}" Click="Pause_Click" IsEnabled="False">
                            <StackPanel>
                                <TextBlock x:Name="PauseIcon" Style="{StaticResource IconText}" Text="&#xE769;" FontSize="18"/>
                                <TextBlock x:Name="PauseLabel" Text="일시정지" Style="{StaticResource ToolCaption}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ScreenshotButton" Style="{StaticResource ToolButton}" Click="Screenshot_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE722;" FontSize="18"/>
                                <TextBlock Text="캡처" Style="{StaticResource ToolCaption}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DrawButton" Style="{StaticResource ToolButton}" Click="Draw_Click">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xEDFB;" FontSize="18"/>
                                <TextBlock Text="그리기" Style="{StaticResource ToolCaption}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ReplayButton" Style="{StaticResource ToolButton}" Width="64" Click="Replay_Click"
                                ToolTip="리플레이 버퍼: 켜 두면 녹화 버튼을 누르지 않아도 최근 장면을 계속 기억했다가, 단축키 한 번으로 파일로 저장합니다">
                            <StackPanel>
                                <TextBlock x:Name="ReplayIcon" Style="{StaticResource IconText}" Text="&#xE81C;" FontSize="18"/>
                                <TextBlock x:Name="ReplayLabel" Text="리플레이" Style="{StaticResource ToolCaption}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sound sources with live meters -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Rectangle Width="1" Height="36" Fill="{StaticResource Border}" Margin="0,0,12,0"/>
                        <StackPanel>
                            <ToggleButton x:Name="SystemToggle" Style="{StaticResource SoundToggle}" Click="SoundToggle_Click"
                                          ToolTip="컴퓨터에서 나는 소리(게임, 영상, 음악)를 함께 녹음">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE767;" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="시스템"/>
                                </StackPanel>
                            </ToggleButton>
                            <ProgressBar x:Name="SystemMeter" Style="{StaticResource Meter}" Visibility="Hidden" ToolTip="녹음되는 소리 크기" Foreground="{StaticResource Accent}"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <ToggleButton x:Name="MicToggle" Style="{StaticResource SoundToggle}" Click="SoundToggle_Click"
                                          ToolTip="마이크 목소리를 함께 녹음">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE720;" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="마이크"/>
                                </StackPanel>
                            </ToggleButton>
                            <ProgressBar x:Name="MicMeter" Style="{StaticResource Meter}" Visibility="Hidden" ToolTip="녹음되는 소리 크기" Foreground="{StaticResource Ok}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PinButton" Style="{StaticResource ToolButton}" Click="Pin_Click">
                            <StackPanel>
                                <TextBlock x:Name="PinIcon" Style="{StaticResource IconText}" Text="&#xE718;" FontSize="18"/>
                                <TextBlock x:Name="PinLabel" Text="위에 고정" Style="{StaticResource ToolCaption}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Click="OpenFolder_Click" ToolTip="녹화 파일이 저장되는 폴더 열기">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" FontSize="18"/>
                                <TextBlock Text="폴더" Style="{StaticResource ToolCaption}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}" Click="Settings_Click" ToolTip="화질, 효과, 단축키 등 설정">
                            <StackPanel>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="18"/>
                                <TextBlock Text="설정" Style="{StaticResource ToolCaption}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Status ===== -->
            <Grid Margin="14,8,14,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="대기 중" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="HintText" FontSize="12" Foreground="{StaticResource TextFaint}"/>
                    <TextBlock x:Name="DiskText" FontSize="12" Foreground="{StaticResource TextFaint}" Margin="12,0,0,0"
                               ToolTip="저장 폴더가 있는 드라이브의 남은 공간"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
