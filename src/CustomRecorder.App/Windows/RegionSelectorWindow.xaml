<Window x:Class="CustomRecorder.App.Windows.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Cursor="Cross"
        UseLayoutRounding="True">
    <Canvas x:Name="Root" Background="Transparent"
            MouseLeftButtonDown="Root_MouseDown" MouseMove="Root_MouseMove" MouseLeftButtonUp="Root_MouseUp">
        <!-- Dimmed outside: one path with the selection punched out -->
        <Path x:Name="Shade" Fill="#80000000" IsHitTestVisible="False">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="ShadeFull"/>
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="ShadeHole"/>
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>
        <Rectangle x:Name="Selection" Stroke="#4C8DFF" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="SizeTag" Background="#E61E1F24" CornerRadius="4" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" FontSize="12"/>
        </Border>
        <Border x:Name="Help" Background="#E61E1F24" CornerRadius="6" Padding="14,8" IsHitTestVisible="False">
            <TextBlock Text="드래그해서 녹화 영역을 지정하세요 · Esc 취소" FontSize="13"/>
        </Border>
    </Canvas>
</Window>
