<Window x:Class="CustomRecorder.App.Windows.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CustomRecorder.App.Controls"
        Title="예약 녹화" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}" WindowStyle="SingleBorderWindow" ResizeMode="NoResize" Topmost="True">
    <StackPanel>
        <Grid Height="76" Margin="24,0,10,0">
            <StackPanel VerticalAlignment="Center" Margin="0,0,50,0">
                <TextBlock Text="예약 녹화" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="정한 시각에 지금 선택된 대상(화면·영역·창·소리)을 자동으로 녹화합니다. 이 프로그램이 켜져 있어야 합니다."/>
            </StackPanel>
            <Button Style="{StaticResource CloseButton}" Width="34" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="10"/>
            </Button>
        </Grid>
        <StackPanel Margin="24,0,24,6">
            <c:SettingRow Icon="&#xE787;" Title="시작 날짜">
                <ComboBox x:Name="DayCombo" Width="160"/>
            </c:SettingRow>
            <c:SettingRow Icon="&#xE823;" Title="시작 시각" Description="24시간 형식 (예: 21:30)">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="HourCombo" Width="76"/>
                    <TextBlock Text=":" Margin="6,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MinuteCombo" Width="76"/>
                </StackPanel>
            </c:SettingRow>
            <c:SettingRow Icon="&#xE916;" Title="녹화 길이" Description="이 시간만큼 녹화한 뒤 자동으로 저장합니다">
                <ComboBox x:Name="LengthCombo" Width="160"/>
            </c:SettingRow>
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Margin="2,8,0,0"/>
        </StackPanel>
        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,12,22,14" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" Content="취소" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="예약하기" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
