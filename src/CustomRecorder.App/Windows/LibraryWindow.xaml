<Window x:Class="CustomRecorder.App.Windows.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="최근 녹화" Width="860" Height="640" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" MinWidth="640" MinHeight="420">
    <Window.Resources>
        <Style x:Key="Filter" TargetType="RadioButton" BasedOn="{StaticResource ModeToggle}"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Height="76" Margin="24,0,10,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="최근 녹화" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="FolderText" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButton}" Width="34" Height="32" Click="Refresh_Click" ToolTip="새로 고침">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="13"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Width="34" Height="32" Margin="4,0,0,0" Click="OpenFolder_Click" ToolTip="탐색기에서 저장 폴더 열기">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" FontSize="13"/>
                </Button>
                <Button Style="{StaticResource CloseButton}" Width="34" Height="32" Margin="4,0,0,0" Click="Close_Click" ToolTip="닫기">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="3"
                HorizontalAlignment="Left" Margin="24,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FilterAll" Style="{StaticResource Filter}" GroupName="f" Content="전체" IsChecked="True" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterVideo" Style="{StaticResource Filter}" GroupName="f" Content="영상" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterAudio" Style="{StaticResource Filter}" GroupName="f" Content="소리" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterImage" Style="{StaticResource Filter}" GroupName="f" Content="캡처" Checked="Filter_Checked"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0,18,16">
            <StackPanel x:Name="Rows"/>
        </ScrollViewer>
        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="아직 녹화한 파일이 없습니다." Foreground="{StaticResource TextDim}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</Window>
