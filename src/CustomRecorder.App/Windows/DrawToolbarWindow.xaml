<Window x:Class="CustomRecorder.App.Windows.DrawToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="화면에 그리기" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="True"
        Style="{StaticResource AppWindow}" WindowStyle="SingleBorderWindow" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Tool" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Width="38" Height="34" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfacePress}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="34">
                            <Ellipse x:Name="ring" Width="22" Height="22" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse Width="14" Height="14" Fill="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Padding="6,4" Background="{StaticResource Bg}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource IconText}" Text="&#xE76F;" Foreground="{StaticResource TextFaint}" Margin="4,0,8,0" ToolTip="여기를 끌어 옮기기"/>
            <RadioButton x:Name="PenTool" Style="{StaticResource Tool}" GroupName="tool" IsChecked="True" Checked="Tool_Checked" ToolTip="펜 (1)">
                <TextBlock Style="{StaticResource IconText}" Text="&#xEDFB;" FontSize="16"/>
            </RadioButton>
            <RadioButton x:Name="MarkerTool" Style="{StaticResource Tool}" GroupName="tool" Checked="Tool_Checked" ToolTip="형광펜 — 반투명하게 덧칠 (2)">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE7E6;" FontSize="16"/>
            </RadioButton>
            <RadioButton x:Name="EraserTool" Style="{StaticResource Tool}" GroupName="tool" Checked="Tool_Checked" ToolTip="지우개 — 선을 눌러 지우기 (3)">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE75C;" FontSize="16"/>
            </RadioButton>
            <RadioButton x:Name="PointerTool" Style="{StaticResource Tool}" GroupName="tool" Checked="Tool_Checked"
                         ToolTip="마우스 — 그림은 남겨 두고 아래 프로그램을 평소처럼 조작 (4)">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE8B0;" FontSize="16"/>
            </RadioButton>
            <Rectangle Width="1" Fill="{StaticResource Border}" Margin="6,6"/>
            <RadioButton Style="{StaticResource Swatch}" GroupName="color" Background="#FF4D5E" IsChecked="True" Checked="Color_Checked" ToolTip="빨강"/>
            <RadioButton Style="{StaticResource Swatch}" GroupName="color" Background="#FFD23F" Checked="Color_Checked" ToolTip="노랑"/>
            <RadioButton Style="{StaticResource Swatch}" GroupName="color" Background="#3DD68C" Checked="Color_Checked" ToolTip="초록"/>
            <RadioButton Style="{StaticResource Swatch}" GroupName="color" Background="#4C8DFF" Checked="Color_Checked" ToolTip="파랑"/>
            <RadioButton Style="{StaticResource Swatch}" GroupName="color" Background="#FFFFFF" Checked="Color_Checked" ToolTip="흰색"/>
            <RadioButton Style="{StaticResource Swatch}" GroupName="color" Background="#111216" Checked="Color_Checked" ToolTip="검정"/>
            <Rectangle Width="1" Fill="{StaticResource Border}" Margin="6,6"/>
            <RadioButton x:Name="ThinSize" Style="{StaticResource Tool}" GroupName="size" Checked="Size_Checked" ToolTip="얇게">
                <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </RadioButton>
            <RadioButton x:Name="MidSize" Style="{StaticResource Tool}" GroupName="size" IsChecked="True" Checked="Size_Checked" ToolTip="보통">
                <Ellipse Width="8" Height="8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </RadioButton>
            <RadioButton x:Name="ThickSize" Style="{StaticResource Tool}" GroupName="size" Checked="Size_Checked" ToolTip="굵게">
                <Ellipse Width="13" Height="13" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </RadioButton>
            <Rectangle Width="1" Fill="{StaticResource Border}" Margin="6,6"/>
            <Button Style="{StaticResource IconButton}" Width="38" Height="34" Click="Undo_Click" ToolTip="되돌리기 (Ctrl + Z)">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" FontSize="15"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="38" Height="34" Click="Clear_Click" ToolTip="모두 지우기 (Delete)">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" FontSize="15"/>
            </Button>
            <Button Style="{StaticResource CloseButton}" Width="38" Height="34" Margin="2,0,0,0" Click="Close_Click" ToolTip="그리기 끝내기 (Esc) — 그린 내용도 사라집니다">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="11"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
