<Window x:Class="CustomRecorder.App.Windows.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="자르기 · GIF" Width="980" Height="680" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}" WindowStyle="SingleBorderWindow" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Height="76" Margin="24,0,10,0">
            <StackPanel VerticalAlignment="Center" Margin="0,0,60,0">
                <TextBlock Text="필요한 부분만 남기기" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="FileText" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
            <Button Style="{StaticResource CloseButton}" Width="34" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="닫기">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="10"/>
            </Button>
        </Grid>

        <!-- Preview -->
        <Border Grid.Row="1" Background="Black" CornerRadius="8" Margin="24,0" ClipToBounds="True">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                          MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>
        </Border>

        <!-- Timeline -->
        <StackPanel Grid.Row="2" Margin="24,14,24,0">
            <Grid Height="28">
                <Canvas x:Name="RangeCanvas" Height="6" VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False">
                    <Rectangle x:Name="RangeBar" Height="6" RadiusX="3" RadiusY="3" Fill="{StaticResource RecSoft}"/>
                </Canvas>
                <Slider x:Name="Timeline" Minimum="0" Maximum="1" ValueChanged="Timeline_ValueChanged"
                        PreviewMouseLeftButtonDown="Timeline_MouseDown" PreviewMouseLeftButtonUp="Timeline_MouseUp"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Width="40" Height="36" Click="Play_Click" ToolTip="재생 / 멈춤 (Space)">
                        <TextBlock x:Name="PlayIcon" Style="{StaticResource IconText}" Text="&#xE768;" FontSize="16"/>
                    </Button>
                    <TextBlock x:Name="TimeText" Text="0:00.0 / 0:00.0" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DialogButton}" Click="SetStart_Click" ToolTip="지금 보이는 장면부터 남깁니다 ([ 키)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE892;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="여기서 시작"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DialogButton}" Margin="6,0,0,0" Click="SetEnd_Click" ToolTip="지금 보이는 장면까지 남깁니다 (] 키)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="여기서 끝"/>
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE893;" FontSize="12" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Background="{StaticResource Surface}" CornerRadius="9" Padding="16,12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="RangeText" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="다시 압축하지 않고 잘라서 화질 손실 없이 몇 초 만에 저장됩니다. 영상은 키프레임에서만 시작할 수 있어 시작 지점이 조금 앞당겨질 수 있습니다. 원본 파일은 그대로 남습니다."/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,12,22,14" Margin="0,14,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,560,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="GifSizeCombo" Width="118" ToolTip="GIF 가로 크기. 작을수록 파일이 가볍습니다"/>
                    <ComboBox x:Name="GifFpsCombo" Width="92" Margin="6,0,0,0" ToolTip="GIF의 1초당 장면 수"/>
                    <Button x:Name="GifButton" Style="{StaticResource DialogButton}" Margin="6,0,16,0" Click="Gif_Click" IsEnabled="False"
                            ToolTip="고른 구간을 움직이는 GIF 이미지로 저장합니다. 메신저, 블로그, README에 바로 붙일 수 있습니다">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B9;" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="GIF로 저장"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DialogButton}" Content="취소" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="영상으로 저장" Click="Save_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
