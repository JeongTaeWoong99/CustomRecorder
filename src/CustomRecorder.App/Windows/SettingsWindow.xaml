<Window x:Class="CustomRecorder.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CustomRecorder.App.Controls"
        Title="설정" Width="940" Height="660" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}" WindowStyle="SingleBorderWindow" ResizeMode="NoResize" Topmost="True">
    <Window.Resources>
        
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="12,9">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="mark" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource Accent}"
                                    HorizontalAlignment="Left" Visibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="240"/>
        </Style>
        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="190"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Segoe UI"/>
            <Setter Property="ToolTip" Value="클릭한 다음 원하는 키 조합을 누르세요. Backspace = 사용 안 함"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,0,14">
                    <Image Source="/Assets/app.ico" Width="18" Height="18" Margin="0,0,10,0"/>
                    <TextBlock Text="설정" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="10,0" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem Tag="PageGeneral">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE80F;" FontSize="15" Margin="0,0,12,0"/><TextBlock Text="일반"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageRecord">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE714;" FontSize="15" Margin="0,0,12,0"/><TextBlock Text="녹화"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageOutput">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE9F9;" FontSize="15" Margin="0,0,12,0"/><TextBlock Text="화질 · 파일"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageEffects">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE790;" FontSize="15" Margin="0,0,12,0"/><TextBlock Text="효과"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageSound">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE767;" FontSize="15" Margin="0,0,12,0"/><TextBlock Text="소리"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageSave">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" FontSize="15" Margin="0,0,12,0"/><TextBlock Text="저장"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageHotkeys">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE765;" FontSize="15" Margin="0,0,12,0"/><TextBlock Text="단축키"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="PageAbout">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="&#xE946;" FontSize="15" Margin="0,0,12,0"/><TextBlock Text="정보 · 업데이트"/></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (also the drag area) -->
            <Grid Height="44">
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                        IsCancel="True" Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="닫기 (저장하지 않음)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </Grid>
            <StackPanel Grid.Row="0" Margin="28,14,60,0" IsHitTestVisible="False">
                <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageDesc" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,4,0,14"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,22,0">
                <Grid>
                    <!-- ===== 일반 ===== -->
                    <StackPanel x:Name="PageGeneral" Style="{StaticResource Page}">
                        <c:SettingRow Icon="&#xE916;" Title="카운트다운"
                                      Description="녹화 버튼을 누른 뒤 3, 2, 1을 보여주고 시작합니다. 화면을 정리할 시간이 필요할 때 쓰세요.">
                            <ComboBox x:Name="CountdownCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE823;" Title="자동 종료"
                                      Description="정한 시간이 지나면 녹화를 스스로 멈추고 저장합니다. 자리를 비울 때 유용합니다.">
                            <ComboBox x:Name="AutoStopCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE8DA;" Title="녹화가 끝나면"
                                      Description="파일 저장이 끝난 직후 자동으로 할 일을 고릅니다.">
                            <ComboBox x:Name="AfterCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE75B;" Title="작업 표시줄 빠른 버튼"
                                      Description="녹화·캡처·리플레이 버튼을 작업 표시줄에 둡니다. 한 번 클릭으로 바로 실행되고, 리플레이 버튼은 꺼져 있으면 켜고 켜져 있으면 저장합니다. 오른쪽 클릭하면 메뉴가 나옵니다. 열린 앱이 많아 작업 표시줄에 자리가 없으면 그동안은 알림 영역(^) 아이콘으로 바뀝니다.">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="QuickPlaceCombo" Width="190" Margin="0,0,10,0" VerticalAlignment="Center"
                                          ToolTip="작업 표시줄: 알림 영역(시계 쪽 아이콘들) 바로 왼쪽 빈자리에 버튼 3개를 붙입니다.&#x0a;알림 영역 아이콘: ^ 안에 들어가는 작은 아이콘 3개로 둡니다."/>
                                <CheckBox x:Name="QuickButtonsCheck" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE7E8;" Title="Windows를 켜면 자동 실행"
                                      Description="컴퓨터를 켤 때 알림 영역에 조용히 실행해 둡니다. 리플레이 버퍼나 단축키를 늘 쓰신다면 켜 두세요.">
                            <CheckBox x:Name="AutostartCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE7B3;" Title="녹화 영상에 툴바가 찍히지 않게 하기"
                                      Description="녹화·리플레이·캡처하는 동안 이 프로그램의 창을 영상에서 빼냅니다. 그동안은 원격 데스크톱·화면 공유에서도 창이 안 보이거나 검게 보입니다. 원격으로 녹화를 조작하거나 툴바까지 찍고 싶으면 끄세요.">
                            <CheckBox x:Name="HideFromCaptureCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xED1A;" Title="녹화하는 동안 툴바 숨기기"
                                      Description="녹화를 시작하면 툴바를 알림 영역으로 내리고, 끝나면 다시 보여줍니다. 녹화 중에는 알림 영역 아이콘에 빨간 점이 붙고, 녹화 단축키나 아이콘 메뉴로 멈출 수 있습니다.">
                            <CheckBox x:Name="HideWhileRecordingCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE7E8;" Title="닫기 버튼으로 트레이에 숨기기"
                                      Description="창의 X를 눌러도 꺼지지 않고 작업 표시줄 오른쪽 알림 영역에서 기다립니다. 숨어 있는 동안에도 단축키가 동작하고, 완전히 끄려면 트레이 아이콘 메뉴의 '종료'를 누르세요.">
                            <CheckBox x:Name="TrayCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                    </StackPanel>

                    <!-- ===== 녹화 ===== -->
                    <StackPanel x:Name="PageRecord" Style="{StaticResource Page}">
                        <c:SettingRow Icon="&#xE916;" Title="프레임 (FPS)"
                                      Description="1초에 찍는 장면 수입니다. 게임처럼 움직임이 많으면 60, 문서·강의 화면은 30이면 충분하고 용량도 절반입니다.">
                            <ComboBox x:Name="FpsCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE8B0;" Title="마우스 커서 함께 찍기"
                                      Description="녹화 영상에 마우스 포인터를 보이게 합니다.">
                            <CheckBox x:Name="CursorCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE81C;" Title="리플레이 길이"
                                      Description="툴바의 '리플레이'를 켜 두면, 녹화 버튼을 누르지 않았어도 리플레이 저장 단축키로 방금 지나간 장면을 이 길이만큼 저장합니다. (10초 단위로 올림)">
                            <ComboBox x:Name="ReplayCombo"/>
                        </c:SettingRow>
                    </StackPanel>

                    <!-- ===== 화질 · 파일 ===== -->
                    <StackPanel x:Name="PageOutput" Style="{StaticResource Page}">
                        <Border Background="{StaticResource AccentSoft}" CornerRadius="9" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="QualityHint" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock x:Name="EncoderHint" Style="{StaticResource Caption}" Margin="26,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <c:SettingRow Icon="&#xE714;" Title="코덱"
                                      Description="H.264는 어떤 기기에서든 재생됩니다. HEVC는 같은 화질에 용량이 약 40% 작지만, 오래된 기기나 일부 웹사이트에서는 재생되지 않을 수 있습니다.">
                            <ComboBox x:Name="CodecCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE7B3;" Title="화질"
                                      Description="비트레이트를 '자동'으로 둘 때 화질과 용량 사이의 기준입니다.">
                            <ComboBox x:Name="QualityCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE9D2;" Title="비트레이트"
                                      Description="1초에 쓰는 데이터 양입니다. 높을수록 선명하고 파일이 커집니다. 직접 정하면 위의 화질 설정은 쓰이지 않습니다.">
                            <ComboBox x:Name="BitrateCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE8C6;" Title="키프레임 간격"
                                      Description="영상을 자르거나 건너뛸 수 있는 지점의 간격입니다. 짧을수록 편집이 정확하고, 길수록 용량이 조금 줄어듭니다.">
                            <ComboBox x:Name="KeyframeCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE740;" Title="저장 해상도"
                                      Description="화면보다 작은 크기로 줄여 저장합니다. QHD·4K 화면을 1080p로 저장하면 용량이 크게 줄어듭니다. 화면보다 크게 늘리지는 않습니다.">
                            <ComboBox x:Name="ResolutionCombo"/>
                        </c:SettingRow>
                    </StackPanel>

                    <!-- ===== 효과 ===== -->
                    <StackPanel x:Name="PageEffects" Style="{StaticResource Page}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="마우스" Margin="2,0,0,8"/>
                        <c:SettingRow Icon="&#xE7C9;" Title="커서 강조"
                                      Description="마우스 주변에 노란 원을 그려 포인터가 어디 있는지 잘 보이게 합니다.">
                            <CheckBox x:Name="HighlightCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE962;" Title="클릭 표시"
                                      Description="클릭한 자리에 물결을 그립니다. 왼쪽 클릭은 파란색, 오른쪽 클릭은 빨간색입니다.">
                            <CheckBox x:Name="ClickCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="키보드"/>
                        <c:SettingRow Icon="&#xE765;" Title="누른 키 보여주기"
                                      Description="누른 키를 화면 아래에 말풍선으로 띄웁니다(예: Ctrl + C). 사용법 영상에 좋습니다. '모든 키'는 입력한 글자가 그대로 찍히므로 비밀번호를 입력할 때는 끄세요.">
                            <ComboBox x:Name="KeyDisplayCombo"/>
                        </c:SettingRow>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="웹캠"/>
                        <c:SettingRow x:Name="WebcamRow" Icon="&#xE960;" Title="웹캠 화면 넣기"
                                      Description="녹화 영상 구석에 웹캠 화면을 작게 겹쳐 넣습니다(PIP). 강의나 게임 방송 영상에 쓰세요.">
                            <CheckBox x:Name="WebcamCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <StackPanel x:Name="WebcamPanel">
                            <c:SettingRow Title="카메라" Description="사용할 웹캠">
                                <ComboBox x:Name="WebcamCombo"/>
                            </c:SettingRow>
                            <c:SettingRow Title="위치 · 크기 · 모양" Description="웹캠 화면을 둘 자리와 크기, 모양">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="WebcamPosCombo" Width="120"/>
                                    <ComboBox x:Name="WebcamSizeCombo" Width="100" Margin="6,0"/>
                                    <ComboBox x:Name="WebcamShapeCombo" Width="110"/>
                                </StackPanel>
                            </c:SettingRow>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="워터마크"/>
                        <c:SettingRow Icon="&#xE8D2;" Title="워터마크 넣기"
                                      Description="채널 이름 같은 글자를 영상 위에 반투명하게 계속 표시합니다.">
                            <CheckBox x:Name="WatermarkCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <StackPanel x:Name="WatermarkPanel">
                            <c:SettingRow Title="문구">
                                <TextBox x:Name="WatermarkBox" Width="240" MaxLength="80"/>
                            </c:SettingRow>
                            <c:SettingRow Title="위치">
                                <ComboBox x:Name="WatermarkPosCombo"/>
                            </c:SettingRow>
                            <c:SettingRow Title="불투명도" Description="낮을수록 흐리게 보입니다">
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="WatermarkOpacity" Width="190" Minimum="0.1" Maximum="1"/>
                                    <TextBlock Text="{Binding Value, ElementName=WatermarkOpacity, StringFormat={}{0:P0}}" Width="44" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                            </c:SettingRow>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="2,10,0,0"
                                   Text="효과는 녹화 파일에만 그려지고 실제 화면에는 나타나지 않습니다."/>
                    </StackPanel>

                    <!-- ===== 소리 ===== -->
                    <StackPanel x:Name="PageSound" Style="{StaticResource Page}">
                        <c:SettingRow Icon="&#xE720;" Title="마이크 장치" Description="목소리를 녹음할 마이크">
                            <ComboBox x:Name="MicCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE767;" Title="시스템 소리 크기" Description="컴퓨터에서 나는 소리(게임, 영상, 음악)가 녹음되는 크기">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="SystemVolume" Width="190" Minimum="0" Maximum="2"/>
                                <TextBlock Text="{Binding Value, ElementName=SystemVolume, StringFormat={}{0:P0}}" Width="48" TextAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE720;" Title="마이크 소리 크기" Description="목소리가 작게 들리면 키우세요">
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="MicVolume" Width="190" Minimum="0" Maximum="2"/>
                                <TextBlock Text="{Binding Value, ElementName=MicVolume, StringFormat={}{0:P0}}" Width="48" TextAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE720;" Title="마이크 잡음 줄이기"
                                      Description="말하지 않을 때 들어오는 팬 소리, 키보드 소리, 방 울림을 꺼 줍니다. 말을 시작하면 바로 다시 열립니다. 작은 목소리가 잘리면 직접 설정에서 기준을 낮추세요.">
                            <CheckBox x:Name="NoiseGateCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <StackPanel x:Name="NoiseGatePanel">
                            <c:SettingRow Title="기준 정하는 방법"
                                          Description="자동: 방의 기본 소음을 계속 재서 그보다 확실히 큰 소리만 통과시킵니다. 직접 설정: 아래 막대에서 기준을 끌어서 정합니다.">
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="GateAuto" Style="{StaticResource ModeToggle}" GroupName="gate" Content="자동" Checked="GateMode_Checked"/>
                                        <RadioButton x:Name="GateCustom" Style="{StaticResource ModeToggle}" GroupName="gate" Content="직접 설정" Checked="GateMode_Checked"/>
                                    </StackPanel>
                                </Border>
                            </c:SettingRow>
                            <Border Background="{StaticResource Surface}" CornerRadius="9" Padding="16,12" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="입력 감도" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="GateValueText" HorizontalAlignment="Right" Foreground="{StaticResource TextDim}"
                                                   FontFamily="Cascadia Mono, Consolas"/>
                                    </Grid>
                                    <Grid x:Name="GateBar" Height="26" Margin="0,8,0,0" Background="Transparent" Cursor="Hand"
                                          MouseLeftButtonDown="GateBar_MouseDown" MouseMove="GateBar_MouseMove" MouseLeftButtonUp="GateBar_MouseUp"
                                          SizeChanged="GateBar_SizeChanged">
                                        <Border Height="8" CornerRadius="4" Background="{StaticResource SurfacePress}" VerticalAlignment="Center"/>
                                        <Border x:Name="GateLevel" Height="8" CornerRadius="4" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Border x:Name="GateMarker" Width="4" Height="20" CornerRadius="2" Background="{StaticResource Text}"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="GateHint" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="말을 해 보세요. 막대가 초록색이면 녹음되고, 노란색이면 잡음으로 보고 꺼집니다."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <c:SettingRow Icon="&#xE8F1;" Title="시스템 소리와 마이크 따로 저장"
                                      Description="영상에 소리 트랙을 3개 넣습니다(1: 합친 소리, 2: 시스템, 3: 마이크). 편집 프로그램에서 목소리와 게임 소리를 따로 조절할 수 있습니다. 둘 다 켰을 때만 적용되고 리플레이는 제외됩니다.">
                            <CheckBox x:Name="SeparateTracksCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE8D6;" Title="'소리만' 녹음 형식"
                                      Description="툴바에서 '소리만'을 골랐을 때 저장할 파일 형식입니다.">
                            <ComboBox x:Name="SoundFormatCombo"/>
                        </c:SettingRow>
                    </StackPanel>

                    <!-- ===== 저장 ===== -->
                    <StackPanel x:Name="PageSave" Style="{StaticResource Page}">
                        <c:SettingRow Icon="&#xE8B7;" Title="저장 폴더" Description="녹화, 리플레이, 캡처, 녹음 파일이 모두 이곳에 저장됩니다.">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="FolderBox" Width="250"/>
                                <Button Style="{StaticResource DialogButton}" Content="찾기" Margin="6,0,0,0" MinWidth="60" Padding="12,6" Click="Browse_Click"/>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE8AC;" Title="파일 이름 규칙"
                                      Description="{}{종류} 녹화·리플레이·캡처·녹음 · {날짜} 2026-10-19 · {시간} 22-30-05 · {대상} 모니터1, 영역, 창의 프로그램 이름">
                            <StackPanel>
                                <TextBox x:Name="PatternBox" Width="250"/>
                                <TextBlock x:Name="PatternPreview" Style="{StaticResource Caption}" Width="250" Margin="2,5,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE722;" Title="캡처 이미지 형식" Description="PNG는 글자가 깨끗하고, JPG는 용량이 작습니다.">
                            <ComboBox x:Name="ShotFormatCombo"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE77F;" Title="캡처를 클립보드에도 복사" Description="캡처하자마자 Ctrl + V로 메신저나 문서에 바로 붙여 넣을 수 있습니다.">
                            <CheckBox x:Name="ClipboardCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                    </StackPanel>

                    <!-- ===== 단축키 ===== -->
                    <StackPanel x:Name="PageHotkeys" Style="{StaticResource Page}">
                        <c:SettingRow Icon="&#xE7C8;" Title="녹화 시작 / 중지">
                            <StackPanel Orientation="Horizontal">
                                <Grid>
                                    <TextBox x:Name="HkRecord" Style="{StaticResource HotkeyBox}"/>
                                    <TextBlock Text="사용 안 함" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               x:Name="HkRecordHint"/>
                                </Grid>
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0" Tag="HkRecord" Click="ClearHotkey_Click"
                                        ToolTip="이 단축키 사용 안 함">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE769;" Title="일시정지 / 다시 시작">
                            <StackPanel Orientation="Horizontal">
                                <Grid>
                                    <TextBox x:Name="HkPause" Style="{StaticResource HotkeyBox}"/>
                                    <TextBlock Text="사용 안 함" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               x:Name="HkPauseHint"/>
                                </Grid>
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0" Tag="HkPause" Click="ClearHotkey_Click"
                                        ToolTip="이 단축키 사용 안 함">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE722;" Title="화면 캡처">
                            <StackPanel Orientation="Horizontal">
                                <Grid>
                                    <TextBox x:Name="HkShot" Style="{StaticResource HotkeyBox}"/>
                                    <TextBlock Text="사용 안 함" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               x:Name="HkShotHint"/>
                                </Grid>
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0" Tag="HkShot" Click="ClearHotkey_Click"
                                        ToolTip="이 단축키 사용 안 함">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE81C;" Title="리플레이 저장" Description="리플레이가 켜져 있을 때 최근 장면을 파일로 저장">
                            <StackPanel Orientation="Horizontal">
                                <Grid>
                                    <TextBox x:Name="HkReplay" Style="{StaticResource HotkeyBox}"/>
                                    <TextBlock Text="사용 안 함" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               x:Name="HkReplayHint"/>
                                </Grid>
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0" Tag="HkReplay" Click="ClearHotkey_Click"
                                        ToolTip="이 단축키 사용 안 함">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xEDFB;" Title="화면에 그리기" Description="펜으로 화면에 표시하는 도구를 열고 닫기">
                            <StackPanel Orientation="Horizontal">
                                <Grid>
                                    <TextBox x:Name="HkDraw" Style="{StaticResource HotkeyBox}"/>
                                    <TextBlock Text="사용 안 함" Foreground="{StaticResource TextFaint}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               x:Name="HkDrawHint"/>
                                </Grid>
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0,0,0" Tag="HkDraw" Click="ClearHotkey_Click"
                                        ToolTip="이 단축키 사용 안 함">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </c:SettingRow>
                        <TextBlock x:Name="HotkeyWarning" Style="{StaticResource Caption}" Foreground="{StaticResource Rec}" Margin="2,6,0,0"/>
                        <Button Style="{StaticResource DialogButton}" Content="기본값으로 되돌리기" HorizontalAlignment="Left" Margin="0,8,0,0" Click="HotkeyDefaults_Click"/>
                    </StackPanel>

                    <!-- ===== 정보 · 업데이트 ===== -->
                    <StackPanel x:Name="PageAbout" Style="{StaticResource Page}">
                        <c:SettingRow Icon="&#xE946;" Title="현재 버전" Description="CustomRecorder · 광고 없는 화면 녹화 프로그램">
                            <TextBlock x:Name="VersionText" FontFamily="Cascadia Mono, Consolas" FontSize="14" VerticalAlignment="Center"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE895;" Title="업데이트" x:Name="UpdateRow" Description="GitHub에 올라온 새 버전을 확인합니다.">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckUpdateButton" Style="{StaticResource DialogButton}" Content="업데이트 확인" Click="CheckUpdate_Click"/>
                                <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                            </StackPanel>
                        </c:SettingRow>
                        <Border x:Name="ReleaseNotesBox" Background="{StaticResource Surface}" CornerRadius="9" Padding="16,12" Margin="0,0,0,6" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ReleaseTitle" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ReleaseNotes" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="160"/>
                            </StackPanel>
                        </Border>
                        <c:SettingRow Icon="&#xE7E8;" Title="실행할 때 업데이트 확인"
                                      Description="프로그램을 켤 때 새 버전이 있는지 확인하고, 있으면 툴바에 '업데이트' 버튼을 띄웁니다. 자동으로 설치하지는 않습니다.">
                            <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE9D9;" Title="미리보기(베타) 버전도 받기"
                                      Description="정식 출시 전 테스트 버전까지 업데이트 대상에 넣습니다. 새 기능을 먼저 쓸 수 있지만 문제가 있을 수 있습니다.">
                            <CheckBox x:Name="PrereleaseCheck" Style="{StaticResource Switch}"/>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE71B;" Title="GitHub" Description="소스 코드, 변경 내역, 이전 버전 내려받기">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource DialogButton}" Content="변경 내역" Click="OpenReleases_Click"/>
                                <Button Style="{StaticResource DialogButton}" Content="저장소 열기" Margin="6,0,0,0" Click="OpenRepo_Click"/>
                            </StackPanel>
                        </c:SettingRow>
                        <c:SettingRow Icon="&#xE8A5;" Title="로그 폴더" Description="문제가 생겼을 때 원인을 찾는 기록이 저장되는 곳">
                            <Button Style="{StaticResource DialogButton}" Content="열기" Click="OpenLogs_Click"/>
                        </c:SettingRow>
                        <TextBlock Style="{StaticResource Caption}" Margin="2,10,0,0" TextWrapping="Wrap"
                                   Text="MIT 라이선스. 사용한 오픈소스: Vortice.Windows (MIT), NAudio (MIT)."/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="28,12,22,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DialogButton}" Content="취소" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="저장" IsDefault="True" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
